<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings - Form Nicepay</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position='after'>
                <h2>Nicepay Configuration</h2>
                <div class="row mt16 o_settings_container" name="nicepay">
                    <div class="col-xs-12 col-md-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label string="Merchant ID" for="nicepay_merchant_id" />
                            <field name="nicepay_merchant_id" class="oe_inline" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label string="Merchant Key" for="nicepay_merchant_key" />
                            <field name="nicepay_merchant_key" class="oe_inline" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
